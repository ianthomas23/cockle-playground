{
  "name": "cockle-playground",
  "version": "0.0.1",
  "description": "",
  "scripts": {
    "build": "rspack build",
    "postbuild": "npm run postbuild:copy-assets && npm run postbuild:prepare-wasm",
    "postbuild:copy-assets": "copyfiles -u 1 assets/* dist/",
    "postbuild:prepare-wasm": "node node_modules/@jupyterlite/cockle/lib/tools/prepare_wasm.js --copy dist/",
    "serve": "concurrently 'npm run serve:simple' 'npm run serve:cross-origin'",
    "serve:simple": "npx static-handler --port 4500 dist/",
    "serve:cross-origin": "npx static-handler --cors --coop --coep --corp --port 4501 dist/"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@rspack/cli": "^2.1.3",
    "@rspack/core": "^2.1.3",
    "concurrently": "^10.0.3",
    "copyfiles": "^2.4.1",
    "css-loader": "^7.1.4",
    "static-handler": "^0.5.3",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.2",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@jupyterlite/cockle": "^1.6.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "deepmerge-ts": "^7.1.5"
  }
}
